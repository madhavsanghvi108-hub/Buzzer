doctype html
html
  head
    title=title
    meta(name='viewport' content='width=device-width, initial-scale=1')
    link(rel="stylesheet" href='/style.css')
  body
    header
      img.logo(src='/buzzer-logo.svg')

    div.container
      h2.js-active=`${users.length} joined`
      ol.js-buzzes
        each buzz in buzzes
          li=`${buzz.name} on Team ${buzz.team}`
      button.js-clear='Clear buzzes'
      button.js-disable-buzzer(type='button' disabled=!buzzerEnabled)='Disable Buzzer'
      button.js-enable-buzzer(type='button' disabled=buzzerEnabled)='Enable Buzzer'

    script(src='/socket.io/socket.io.js')
    script(src='/host.js')
